APP_NAME=SIBLU
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8800

# Port host yang dipetakan ke port 80 container (dipakai compose.production.yaml).
APP_PORT=8800

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
# Hostname container shared MySQL pada network shared-net (mis. shared-mysql).
DB_HOST=shared-mysql
DB_PORT=3306
DB_DATABASE=db_siblu
DB_USERNAME=siblu_user
DB_PASSWORD=

CACHE_DRIVER=file
FILESYSTEM_DISK=local
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# false saat uji lokal HTTP, true di production HTTPS.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Kredensial akun awal yang dibuat seeder. Ganti setelah instalasi pertama.
SIBLU_SEED_ADMIN_EMAIL=superadmin@uinsyahada.ac.id
SIBLU_SEED_ADMIN_PASSWORD=
SIBLU_SEED_UNIT_PASSWORD=
